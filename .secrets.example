# =============================================================================
# Secrets Template
# =============================================================================
# Copy this file to ~/.secrets and fill in your values:
#   cp .secrets.example ~/.secrets
#
# IMPORTANT: Never commit ~/.secrets to git!
# The .gitignore in this repo already excludes it.
# =============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
export OPENAI_API_KEY=""

# FRED (Federal Reserve Economic Data) API Key
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
export FRED_API_KEY=""

# Add other secrets below as needed
# export GITHUB_TOKEN=""
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
